{
  "name": "zeemo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Zeemo — AI Engineering Incident Investigation Platform",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:api": "pnpm --filter @zeemo/api run dev",
    "dev:web": "pnpm --filter @zeemo/web run dev",
    "dev:worker": "pnpm --filter @zeemo/worker run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
